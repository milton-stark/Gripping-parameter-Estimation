
<mujoco model="ur5gripper">
    <size memory="100000000"/>
    <compiler angle="radian"
              inertiafromgeom="true"
              texturedir="textures/"
              meshdir="mesh/visual/"/>


              <!--timestep="2e-3"
            iterations="10"
            tolerance="1e-10"
            impratio="20"-->
    <option 
            integrator="implicitfast" timestep="0.002" iterations="50" tolerance="1e-4" impratio="10" cone="elliptic"/>
    <!--size njmax="600" nconmax="150" nstack="300000"/-->

    <default>
        <site rgba="0.8 0.6 0.7 0.3" type="ellipsoid" group="3"/>
        <geom contype='1' conaffinity='1' condim='4'  margin="1e-3"  /> <!--solref=".01 1" solimp=".99 .99 .01"-->
        <!--<joint armature="0.01" damping=".1"/>-->
        <default class="UR5">
            <joint damping='25'/> <!--Og 65-->
        </default>
        <default class="UR5e">
            <joint damping='5'/> <!--Og 45-->
        </default>
        <default class="GRIPPER">
            <joint damping='1'/>
        </default>
        <!--From UR5e-->
        <default class="collision">
            <geom type="capsule" group="0"/>
            <default class="eef_collision">
            <geom type="cylinder"/>
            </default>
        </default>
    </default>

    <visual>
        <map fogstart="3" fogend="5" znear="0.05"/>
        <quality shadowsize="2048"/>
        <scale framelength="0.1"
               framewidth="0.005"
               contactwidth="0.1"
               contactheight="0.005"
               forcewidth="0.01"
               />
    </visual>

    <!--Assets-->
    <asset>
        <!--Meshes-->
        <mesh name="base"           file="base.stl"     />
        <mesh name="shoulder"       file="shoulder.stl" />
        <mesh name="upperarm"       file="upperarm.stl" />
        <mesh name="forearm"        file="forearm.stl"  />
        <mesh name="wrist1"         file="wrist1.stl"   />
        <mesh name="wrist2"         file="wrist2.stl"   />
        <mesh name="wrist3"         file="wrist3.stl"   />

        <mesh name="battery_mesh" file="battery.stl" scale="0.001 0.001 0.001"/>
        <mesh name="casing_mesh"  file="casing.stl"  scale="0.001 0.001 0.001"/>

        <!--Changed-->
        <mesh name="zimmer_gripper_adapter"    file="zimmer_gripper_adapter.stl"     scale = "0.001 0.001 0.001"/>
        <mesh name="zimmer_gripper_left"    file="zimmer_gripper_left.stl"     scale = "0.001 0.001 0.001"/>
        <mesh name="zimmer_gripper_right_new"    file="zimmer_gripper_right_new.stl"     scale = "0.001 0.001 0.001"/>


        <!--Textures-->
        <texture name="ur5_tex"     type="2d"       builtin="flat" height="32" width="32" rgb1="0.45 0.45 0.45" />
        <texture name="gripper_tex" type="2d"       builtin="flat" height="32" width="32" rgb1="0.45 0.45 0.45" rgb2="0 0 0"/>
        <texture name="bench_tex"   type="2d"       builtin="flat" height="32" width="32" rgb1="0.7 0.7 0.7" />
        <texture name="sky_tex"     type="skybox"   builtin="gradient" width="100" height="100" rgb1="1 1 1" rgb2="0.3 0.3 0.8" />
        <texture name="texgeom"     type="cube"     builtin="flat" mark="cross" width="127" height="1278" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" markrgb="1 1 1" random="0.01" />
        <texture name="floor_tex"   type="2d"        builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .2 .3" width="100" height="100" />
        <texture name="wood"        type="cube"     file="wood2.png"/>
        <texture name="metal"        type="cube"     file="metal2.png"/>
        <!--Materials-->
        <material name="ur5_mat"        texture="ur5_tex"   shininess="0.9" specular="0.75" reflectance="0.3" /> <!--rgba="0.2 0.2 0.2 0.2"-->
        <material name="gripper_mat"    texture="gripper_tex"   shininess="0.9" specular="0.75" reflectance="0.4"/>
        <material name='floor_mat'      texture="floor_tex"  shininess="0.8" texrepeat="10 10" specular="0.7"  reflectance="0.5" />
        <material name='geom'           texture="texgeom"   texuniform="true" />
        <material name="bench_mat"      texture="metal"   shininess="0.1" specular="0.5" reflectance="0.2"/>
        <material name="tablecube"      texture="wood" rgba=".8 .8 .8 1"/>

        <material name="battery_mat" rgba="0 1 0 1" shininess="0.5"/>
        <material name="casing_mat"  rgba="0.2 0.2 0.2 1" shininess="0.5"/>

        <!-- IGCV   -->
        <material name="glass" rgba="0.8 0.9 1 0.15" specular="1" shininess="1" reflectance="0.3"/>
    </asset>

    <!--Contacts-->
    <contact>
        <!--<exclude body1="gripperpalm" body2="gripperfinger_1_link_1"/>
		<exclude body1="gripperpalm" body2="gripperfinger_2_link_1"/>
		<exclude body1="gripperpalm" body2="gripperfinger_middle_link_1"/>-->
        <exclude body1="base_link" body2="shoulder_link"/>
		<exclude body1="shoulder_link" body2="upper_arm_link"/>
        <exclude body1="upper_arm_link" body2="forearm_link"/>
		<exclude body1="forearm_link" body2="wrist_1_link"/>
		<exclude body1="wrist_1_link" body2="wrist_2_link"/>
        <exclude body1="wrist_2_link" body2="wrist_3_link"/>
        <exclude body1="robot_cell" body2="base_link"/>
        <exclude body1="robot_cell" body2="shoulder_link"/>
        <exclude body1="robot_cell" body2="upper_arm_link"/>
        <exclude body1="robot_cell" body2="forearm_link"/>
        <exclude body1="robot_cell" body2="wrist_1_link"/>
        <exclude body1="robot_cell" body2="wrist_2_link"/>
        <exclude body1="robot_cell" body2="wrist_3_link"/>
        <exclude body1="robot_cell" body2="ee_link"/>
        <exclude body1="robot_cell" body2="ee_gripper_left_link"/>
        <exclude body1="robot_cell" body2="ee_gripper_right_link"/>
        <exclude body1="ee_gripper_left_link" body2="ee_gripper_right_link"/>
        <!--<exclude body1="wrist_3_link" body2="gripperpalm"/>-->

    </contact>

    <!--MODEL DESCRIPTION-->
    <worldbody>
        <!--Lighting parameters-->
        <light name="light3" mode="targetbody" target="robot_cell" directional="true" pos="1 1 3" />
        <!--Camera parameters-->
        <!--<camera name="main1" mode="fixed" target="gripperpalm" pos="2 2 2.7" axisangle="2 2 -2 1"/>-->
        <!--Floor Property-->
        <geom name='floor' material="floor_mat" pos='0 0 0' size='2.5 2.5 0.1'  type='plane' />

        <site name="world_axes" pos="0 0 0" type="ellipsoid" size="0.01 0.01 0.01" rgba="0 0 0 1" />
        
        <!-- X-Achse (rot) -->
        <geom name="x_axis" type="capsule" fromto="0 0 0 0.2 0 0" size="0.005" rgba="1 0 0 1"/>
        <!-- Y-Achse (grün) -->
        <geom name="y_axis" type="capsule" fromto="0 0 0 0 0.2 0" size="0.005" rgba="0 1 0 1"/>
        <!-- Z-Achse (blau) -->
        <geom name="z_axis" type="capsule" fromto="0 0 0 0 0 0.2" size="0.005" rgba="0 0 1 1"/>


        <!--Robot UR5-
        <body name="box_link" pos="0.2888 0.3355 0.93"> -->
        <body name="robot_cell" pos="0 0 0">

            <!-- Tischplatte -->
            <geom name="table_block" type="box" size="0.525 0.40 0.465" pos="0.525 0.40 0.465" contype="1" conaffinity="1" material="bench_mat" />
            <geom name="table_block_2" type="box" size="0.525 0.40 0.475" pos="0.525 1.20 0.475" contype="1" conaffinity="1" material="bench_mat" />
            <!-- Wand links (x = -0.02 + 0.02) = 0.02 -->
            <geom name="wall_left" type="box" size="0.02 0.40 0.37" pos="0.02 0.40 1.3" contype="1" conaffinity="1" material="glass"/>
            <!-- Wand rechts (x = 1.042 - 0.02 = 1.022) -->
            <geom name="wall_right" type="box" size="0.02 0.40 0.37" pos="1.022 0.40 1.3" contype="1" conaffinity="1" material="glass"/>
            <!-- Wand vorne (y = -0.02 + 0.02 = 0.02) -->
            <geom name="wall_front" type="box" size="0.525 0.02 0.37" pos="0.525 0.02 1.3" contype="1" conaffinity="1" material="glass"/>
            <!-- Decke -->
            <geom name="ceiling" type="box" size="0.525 0.02 0.02" pos="0.525 0.772 1.65" contype="1" conaffinity="1" material="glass"/>
            <!--GreiferFach-->
            <geom name="gripper_shelf" type="box" size="0.075 0.215 0.075" pos="0.945 0.425 1.275" contype="1" conaffinity="1" material="bench_mat"/>

            <inertial pos="0 0 0" mass="1000" diaginertia="0 0 0" />
            <body name="base_link" pos="0.3755 0.325 0.93" quat="-1 0 0 1" >
                <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="4" diaginertia="0.0072 0.00443333 0.00443333" />
                <geom type="mesh"  mesh="base" material="ur5_mat"/>

                <body name="shoulder_link" pos="0 0 0.089159" >
                    <inertial pos="0 0 0" mass="3.7" diaginertia="0.0102675 0.0102675 0.00666" />
                    <joint name="shoulder_pan_joint" class="UR5" pos="0 0 0" axis="0 0 1" limited="true" range="-6.28318 6.28318" />
                    <geom name="shoulder_geom" type="mesh"  mesh="shoulder" material="ur5_mat"/>  
         
                    <body name="upper_arm_link" pos="0 0.13585 0" quat="0.707107 0 0.707107 0"> 
                        <inertial pos="0 0 0.28" mass="8.393" diaginertia="0.226891 0.226891 0.0151074" />
                        <joint name="shoulder_lift_joint" class="UR5" pos="0 0 0" axis="0 1 0" limited="true" range="-6.28318 6.28318" /> <!--Range= -6.28318 6.28318-->
                        <geom name="upperarm_geom" type="mesh"  mesh="upperarm" material="ur5_mat" />

                        <body name="forearm_link" pos="0 -0.1197 0.425">
                            <inertial pos="0 0 0.25" mass="2.275" diaginertia="0.0494433 0.0494433 0.004095" />
                            <joint name="elbow_joint" class="UR5" pos="0 0 0" axis="0 1 0" limited="true" range="-6.28318 6.28318" /> <!--Range= -6.28318 6.28318-->
                            <geom name="forearm_geom" type="mesh"  mesh="forearm" material="ur5_mat"/>

                            <body name="wrist_1_link" pos="0 0 0.39225" quat="0.707107 0 0.707107 0"> <!-- !! quat="1 0 1 0" !!quat="0.707107 0 0.707107 0" > <!-quat="0.707107 0 0.707107 0">-->
                                <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="1.219" diaginertia="0.21942 0.111173 0.111173" />
                                <joint name="wrist_1_joint" class="UR5e" pos="0 0 0" axis="0 1 0" limited="true" range="-6.28318 6.28318" />
                                <geom name="wrist_1_geom" type="mesh"  mesh="wrist1" material="ur5_mat"/>

                                <body name="wrist_2_link" pos="0 0.093 0" >
                                    <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="1.219" diaginertia="0.21942 0.111173 0.111173" />
                                    <joint name="wrist_2_joint" class="UR5e" pos="0 0 0" axis="0 0 1" limited="true" range="-6.28318 6.28318" /> <!--Range= -6.28318 6.28318-->
                                    <geom name="wrist_2_geom" type="mesh"  mesh="wrist2" material="ur5_mat"/>

                                    <body name="wrist_3_link" pos="0 0 0.09465" ><!-- quat="0.707107 0 0.707107 0"-->
                                        <inertial pos="0 0 0" quat="0.5 0.5 -0.5 0.5" mass="0.1879" diaginertia="0.033822 0.0171365 0.0171365" />
                                        <joint name="wrist_3_joint" class="UR5e" pos="0 0 0" axis="0 1 0" limited="true" range="-6.28318 6.28318" />
                                        <geom name="wrist_3_geom" type="mesh"  mesh="wrist3" material="ur5_mat"/>

                                        <!--Changed-->
                                        <body name="ee_link" pos="0 0.08 0" quat="0.5 0.5 -0.54 0.5">
                                            <inertial pos="-0.01 0 0" mass="0.001" diaginertia="1.66667e-08 1.66667e-08 1.66667e-08" />
                                            <geom name="ee_adapter_geom" type="mesh"  mesh="zimmer_gripper_adapter" material="ur5_mat"/>

                                            <body name="ee_gripper_left_link" pos="0.0005 0 0" quat="1 0 0 0">
                                                <inertial pos="-0.01 0 0" mass="0.01" diaginertia="1.66e-08 1.66e-08 1.66e-08" />
                                                
                                                <joint name="ee_gripper_left_joint" type="slide" axis="0 1 0" limited="true" range="-0.006 0.04" />

                                                <geom name="ee_left_visual" type="mesh" mesh="zimmer_gripper_left" material="ur5_mat" contype="0" conaffinity="0" group="1"/>

                                                <geom name="ee_left_col" type="box" size="0.05 0.004 0.015" pos="-0.005 0.018 -0.17" 
                                                    rgba="0 1 0 0.5" group="0"
                                                    friction="1.0 0.005 0.0001" solimp="0.9 0.95 0.001" solref="0.02 1" margin="0.004"
                                                    contype="1" conaffinity="1"/> 

                                                <site name="pinch_L" pos="-0.005  0.018 -0.185" size="0.002" type="sphere" rgba="0 1 1 1"/>

                                                <geom name="ee_left_pad" type="box" pos="-0.005 0.018 -0.185" size="0.02 0.003 0.015" rgba="1 1 0 0.6" group="3" friction="2.0 0.02 0.002"
                                                    solref="0.004 1" solimp="0.9 0.95 0.001" condim="3" priority="5"/>
                                            </body> 

                                            <body name="ee_gripper_right_link" pos="-0.0005 0 0" quat="1 0 0 0">
                                                <inertial pos="0.01 0 0" mass="0.01" diaginertia="1.66e-08 1.66e-08 1.66e-08" />
                                                
                                                <joint name="ee_gripper_right_joint" type="slide" axis="0 1 0" limited="true" range="-0.04 0.006" />

                                                <geom name="ee_right_visual" type="mesh" mesh="zimmer_gripper_right_new" material="ur5_mat" contype="0" conaffinity="0" group="1"/>

                                                <geom name="ee_right_col" type="box" size="0.05 0.004 0.015" pos="-0.005 -0.010 -0.17" 
                                                    rgba="0 1 0 0.5" group="0"
                                                    friction="1.0 0.005 0.0001" solimp="0.9 0.95 0.001" solref="0.02 1" margin="0.004"
                                                    contype="1" conaffinity="1"/>

                                                <site name="pinch_R" pos="-0.005 -0.01 -0.185" size="0.002" type="sphere" rgba="0 1 1 1"/>

                                                <geom name="ee_right_pad" type="box" pos="-0.005 -0.01 -0.185" size="0.02 0.003 0.015" rgba="1 1 0 0.6" group="3" friction="2.0 0.02 0.002"
                                                    solref="0.004 1" solimp="0.9 0.95 0.001" condim="3" priority="5"/>
                                            </body>

                                            <body name="tcp" pos="-0.005 0.004 -0.185" quat="1 0 0 0">
                                                <geom name="tcp_visual" type="sphere" size="0.002" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                                                
                                            </body>

                                            <site name="tcp_tip" pos="-0.005 0.004 -0.185" type="sphere" size="0.001" rgba="1 0.5 0 1"/>
                                            
                                        </body>
                                    </body>
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>

        

        <body name="casing" pos="0.7 0.25 0.965" euler="0 0 1.57">
            <geom type="mesh" mesh="casing_mesh" material="casing_mat" contype="0" conaffinity="0" group="1"/>

            <geom type="box" size="0.05 0.07 0.002" pos="0 0 -0.02" rgba="1 0 0 0" /> 
    
            <geom type="box" size="0.05 0.005 0.02" pos="0 0.075 0" rgba="1 0 0 0"/> 
            <geom type="box" size="0.05 0.005 0.02" pos="0 -0.075 0" rgba="1 0 0 0"/> 
    
            <geom type="box" size="0.005 0.07 0.02" pos="0.055 0 0" rgba="1 0 0 0"/> 
            <geom type="box" size="0.005 0.07 0.02" pos="-0.055 0 0" rgba="1 0 0 0"/>

        </body>

        <body name="battery" pos="0.696 0.228 0.9855" euler="0 0 1.57"> 
                <geom type="mesh" mesh="battery_mesh" material="battery_mat" contype="0" conaffinity="0" group="1" mass="0.0"/>  
                <geom type="box" size="0.00725 0.04125 0.0255" condim="4" friction="2 0.005 0.0001" rgba="0 0 0 0"
                    solimp="0.9 0.95 0.001" solref="0.02 1" margin="0.001" contype="1" conaffinity="1"/> 
        </body>
        
    </worldbody>


    <!--ACTUATORS-->
    <actuator>
        <!--UR5-->
        <position name='shoulder_pan' ctrllimited="true" ctrlrange="-6.28318 6.28318" joint='shoulder_pan_joint' kp="2000" kv="100" forcerange="-150 150"/> <!--kp500-->
        <position name='shoulder_lift' ctrllimited="true" ctrlrange="-6.28318 6.28318" joint='shoulder_lift_joint' kp="2000" kv="100" forcerange="-150 150"/><!--kp500-->
        <position name='forearm' ctrllimited="true" ctrlrange="-6.28318 6.28318" joint='elbow_joint' kp="2000" kv="100" forcerange="-150 150" /><!--kp500-->
        <position name='wrist_1' ctrllimited="true" ctrlrange="-6.28318 6.28318" joint='wrist_1_joint' kp="500" kv="25" forcerange="-28 28" /><!--kp100-->
        <position name='wrist_2' ctrllimited="true" ctrlrange="-6.28318 6.28318" joint='wrist_2_joint' kp="500" kv="25" forcerange="-28 28"/><!--kp100-->
        <position name='wrist_3' ctrllimited="true" ctrlrange="-6.28318 6.28318" joint='wrist_3_joint' kp="500" kv="25" forcerange="-28 28"/><!--kp100-->
        
        <!--Changed-->
        <position name='ee_gripper_left' ctrllimited="true" ctrlrange="-0.03 0.035" joint='ee_gripper_left_joint' kp="400" kv="20" forcerange="-100 100"/><!--kp100-->
        <position name='ee_gripper_right' ctrllimited="true" ctrlrange="-0.035 0.03" joint='ee_gripper_right_joint' kp="400" kv="20" forcerange="-100 100"/><!--kp100-->

        <adhesion name="magnet_left"  body="ee_gripper_left_link"  ctrlrange="0 1" gain="1000" />
        <adhesion name="magnet_right" body="ee_gripper_right_link" ctrlrange="0 1" gain="1000" />
    </actuator>


</mujoco>
